# VibeStation Yellowstone endpoint and optional x-token. Never commit credentials.
GRPC_ENDPOINT=https://your-vibestation-grpc-endpoint:443
GRPC_X_TOKEN=
# Helius HTTP RPC for live trade confirmation and background history/state reads.
# If HELIUS_RPC_URL is set, it takes precedence over RPC_URL.
RPC_URL=https://your-solana-mainnet-rpc
HELIUS_RPC_URL=
# Live trades always use Helius Sender SWQoS (0.000005 SOL minimum tip).
# A tip is paid only when the trade transaction succeeds; it is extra to BUY_SOL.
HELIUS_SENDER_MODE=swqos
HELIUS_TIP_LAMPORTS=5000
# Optional: one of Helius's published tip accounts; blank rotates among them.
HELIUS_TIP_ACCOUNT=
# Comma-separated watched wallets; WATCH_WALLET also works for one wallet.
WATCH_WALLETS=
# Dry-run needs no signer. Live mode requires PRIVATE_KEY (base58 or a 64-byte JSON array). Keep .env private.
PRIVATE_KEY=
DRY_RUN=true
# Live test permits one submitted buy and one submitted sell, counted across restarts.
LIVE_TEST_MODE=true
BUY_SOL=0.01
# Copied buys require at least one age bound and one SOL market-cap bound. Inclusive limits.
MIN_CURVE_AGE_SECONDS=
MAX_CURVE_AGE_SECONDS=
MIN_MARKETCAP_SOL=
MAX_MARKETCAP_SOL=
BUY_SLIPPAGE_PERCENT=12
SELL_SLIPPAGE_PERCENT=50
PRIORITY_FEE_MICROLAMPORTS=10000
MAX_EVENT_AGE_SECONDS=30
MAX_QUEUE=100
